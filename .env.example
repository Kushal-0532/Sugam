# Non-secret config. Copy to .env (gitignored) to override.
# Secrets are read from ~/.env (loaded after this file; never committed):
#   GNANI_API_KEY, GROQ_API_KEY_ALTERNATE (or whatever LLM_API_KEY_VAR names)
TTS_VOICE=Lakshmi

# LLM_PROVIDER: openai (any OpenAI-compatible endpoint: Groq, OpenAI, Gemini) | anthropic
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
# Nov 6: gpt-oss-120b hit Groq's free 200k tokens/day; gpt-oss-20b showed the same exhausted quota
LLM_MODEL=openai/gpt-oss-120b  # Nov 9: user switched back from qwen/qwen3.8-27b (Groq 400/503 errors)
LLM_API_KEY_VAR=GROQ_API_KEY_ALTERNATE
# none: Qwen on Groq allows only 1000 output tokens/min; router call 76 tokens at none vs 462 at low (Nov 6). gpt-oss needs low (no 'off').
LLM_REASONING=low

# jev: Jev decides (task + each agent step), Groq fills in text or takes over when Jev is unsure. groq: Groq only.
PLANNER=jev
